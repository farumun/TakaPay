DATABASE_URL="file:./dev.db"
# Generate each value independently with a cryptographically secure random generator.
AUTH_SECRET=""
APP_BASE_URL="http://localhost:3000"
# Base64-encoded random 32-byte AES-256 key. Use a KMS in production.
CREDENTIAL_ENCRYPTION_KEY=""
OTP_PEPPER=""
RATE_LIMIT_PEPPER=""
# OTP email via Resend
RESEND_API_KEY=""
OTP_EMAIL_FROM=""
# Optional phone OTP via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
# Optional Google OAuth. Set both values to enable Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional Facebook OAuth. Set both values to enable Facebook sign-in.
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Initial super-admin provisioned by the seed only when both are present.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
# Absolute private persistent directory; never place below public/.
PRIVATE_UPLOAD_DIR=""
